{
  "manifest_version": 3,
  "name": "Penduline",
  "version": "1.3.0",
  "description": "Consulte et alimente tes matrices d'Eisenhower depuis ton navigateur.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Penduline",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ],
  "externally_connectable": {
    "matches": [
      "https://penduline.polemil.dev/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
