# Supabase — `.env` à la RACINE, partagé par l'app web ET l'extension.
# Local : `npm run status -w @penduline/supabase` donne l'API URL + l'anon key.
# Distant : Settings > API du projet supabase.com.
# Ces deux valeurs sont PUBLIQUES ; la sécurité repose sur les policies RLS
# définies dans apps/supabase/migrations/.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Cible du bouton « Ouvrir l'app » de l'extension. Optionnelle : sans elle, le
# build retombe sur http://localhost:5173 (serveur de dev).
VITE_WEB_APP_URL=https://penduline.polemil.dev

# ID de l'extension Chrome destinataire du partage de session (app web → extension).
# Sans elle, le partage est simplement inactif : l'app web reste fonctionnelle et
# l'extension garde sa propre connexion.
# Local : chrome://extensions, ID affiché sous « Penduline » (il dépend du CHEMIN
# du dossier, il diffère donc d'une machine à l'autre).
# Prod : l'ID du Chrome Web Store.
VITE_EXTENSION_ID=

# URL publique du serveur MCP (#23) — celle que l'écran de consentement appelle.
# ⚠️ Variable de BUILD : Vite l'inline dans le bundle. La poser à l'exécution
# n'a AUCUN effet, et en changer impose un rebuild, pas un restart.
# Sans elle, l'application marche ; seule l'autorisation d'une application MCP
# est indisponible, et l'écran le dit.
VITE_MCP_URL=https://mcp.penduline.polemil.dev

# ── Serveur MCP (#23) — `apps/mcp` ──────────────────────────────────────────
# Lues au DÉMARRAGE du serveur (pas de préfixe VITE_ : rien n'est inliné ici).
# Le serveur lit ce fichier, mais ne remplit que ce qui manque : une variable
# déjà posée dans l'environnement gagne toujours.
#
# En local, le secret JWT est celui du CLI Supabase — identique partout, il n'a
# rien à protéger sur une machine de développement.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# ⚠️ DOIT différer de SUPABASE_JWT_SECRET, et le serveur refuse de démarrer
# sinon : un jeton d'accès MCP signé avec le secret Supabase serait accepté par
# PostgREST, et n'importe quel client court-circuiterait alors le serveur.
MCP_TOKEN_SECRET=change-moi-un-autre-secret-de-32-caracteres-minimum
MCP_PUBLIC_URL=http://127.0.0.1:8787
WEB_APP_URL=http://localhost:5173
# Facultatifs : PORT (8787), MCP_QUOTA_CALLS_PER_MINUTE (60),
# MCP_QUOTA_WRITES_PER_DAY (500).
